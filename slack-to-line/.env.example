# 「4-3AIP連携課題」の.envと同じ変数名。既存の値をそのままコピーして使える。

# Slack: Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx

# 要約対象のSlackチャンネル(チャンネルID "C0XXXXXXXXX" 推奨。"#general" のような
# チャンネル名でも動くが、実行時にAPIで名前→ID解決が1回余分に走る)
SLACK_CHANNEL=C0XXXXXXXXX

# OpenAI: 4-3AIP連携課題で使用済みのAPIキーをそのまま再利用できる
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# 任意: 要約に使うモデル(省略時は gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# LINE: Messaging APIのChannel access token(長期)
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxx

# 送信先userId/groupId(例: 4-3のLINE_TOと同じ管理者宛)。
# 空のままなら公式LINEアカウントの友だち全員へブロードキャスト送信する。
LINE_TO=
