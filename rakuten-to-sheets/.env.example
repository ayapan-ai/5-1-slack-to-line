# 楽天ウェブサービス(https://webservice.rakuten.co.jp/)で発行したアプリID / アクセスキー
RAKUTEN_APP_ID=xxxxxxxxxxxx
RAKUTEN_ACCESS_KEY=xxxxxxxxxxxx

# 任意: アプリを「許可するWebサイト」で制限している場合、そのURL(例: https://example.com)。
# 「許可されたIPアドレス」で制限している場合は空のままでよい(Originヘッダーとして送信)
RAKUTEN_ORIGIN=

# 任意: 楽天アフィリエイトID。設定するとシートのURLがアフィリエイトリンクになる
RAKUTEN_AFFILIATE_ID=

# GoogleスプレッドシートのID(URLの /d/ と /edit の間の文字列)
SPREADSHEET_ID=xxxxxxxxxxxx

# サービスアカウントのJSONキーのパス(相対パスはこのフォルダ基準)
GOOGLE_CREDENTIALS=credentials.json

# 任意: 値下がり・在庫切れ・在庫復活をLINE通知したい場合に設定。
# slack-to-line/.env と同じ値をコピーすれば同じ公式LINEアカウントから届く
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
